{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GTM lab signal envelope",
  "description": "A constrained CloudEvents 1.0 envelope with a required timestamp and account subject.",
  "type": "object",
  "required": [
    "specversion",
    "source",
    "id",
    "type",
    "subject",
    "time"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "source": {
      "type": "string",
      "format": "uri",
      "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:"
    },
    "id": {
      "type": "string",
      "pattern": "\\S"
    },
    "type": {
      "type": "string",
      "pattern": "\\S"
    },
    "subject": {
      "type": "string",
      "pattern": "\\S"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "additionalProperties": true
}
